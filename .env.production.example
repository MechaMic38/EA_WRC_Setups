COMPOSE_PROJECT_NAME=ea_wrc_setups_production

# App configuration
APP_PORT=10000
APP_URL=http://localhost:10000
APP_KEY=...

# Database configuration
DB_URI="mongodb+srv://..."
DB_DATABASE=ea_wrc_setups

# Storage configuration
PUBLIC_STORAGE_DRIVER=s3
FILESYSTEM_DISK=public

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=ea-wrc-setups-assets
AWS_ENDPOINT=...
AWS_URL=...
AWS_USE_PATH_STYLE_ENDPOINT=true

# Admin user configuration
ADMIN_NAME="EA WRC Setups Admin"
ADMIN_EMAIL=...
ADMIN_PASSWORD=...
